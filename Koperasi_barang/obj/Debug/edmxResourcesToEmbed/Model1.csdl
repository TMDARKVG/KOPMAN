    <Property Name="id_produk" Type="Int32" Nullable="false" />
    <Property Name="kuantitas" Type="Int32" />
    <Property Name="harga_total" Type="Double" />
    <Property Name="tanggal_transaksi" Type="DateTime" Precision="3" />
