  </Association>
  <Association Name="FK_tblDetail_transaksi_tblProduk">
    <End Type="KoperasiModel.tblProduk" Role="tblProduk" Multiplicity="0..1" />
    <End Type="KoperasiModel.tblDetail_transaksi" Role="tblDetail_transaksi" Multiplicity="*" />
