      <End Role="tblProduk" EntitySet="tblProduks" />
      <End Role="tblDetail_transaksi" EntitySet="tblDetail_transaksi" />
    </AssociationSet>
  </EntityContainer>
  <EntityType Name="sysdiagram">
    <Key>
      <PropertyRef Name="diagram_id" />
    </Key>
    <Property Name="name" Type="String" Nullable="false" MaxLength="128" FixedLength="false" Unicode="true" />
    <Property Name="principal_id" Type="Int32" Nullable="false" />
    <Property Name="diagram_id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="version" Type="Int32" />
    <Property Name="definition" Type="Binary" MaxLength="Max" FixedLength="false" />
  </EntityType>
  <EntityType Name="tblDetail_transaksi">
    <Key>
      <PropertyRef Name="id" />
    </Key>
    <Property Name="id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="id_transaksi" Type="Int32" Nullable="false" />
    <Property Name="id_produck" Type="Int32" />
    <Property Name="nama_barang" Type="String" MaxLength="255" FixedLength="false" Unicode="false" />
    <Property Name="kuantitas" Type="Int32" />
    <Property Name="subtotal" Type="Double" />
    <NavigationProperty Name="tblTransaksi" Relationship="KoperasiModel.FK_tblDetail_transaksi_tblTransaksi" FromRole="tblDetail_transaksi" ToRole="tblTransaksi" />
    <NavigationProperty Name="tblProduk" Relationship="KoperasiModel.FK_tblDetail_transaksi_tblProduk" FromRole="tblDetail_transaksi" ToRole="tblProduk" />
  </EntityType>
  <EntityType Name="tblLog">
    <Key>
      <PropertyRef Name="id" />
    </Key>
    <Property Name="id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="id_user" Type="Int32" Nullable="false" />
    <Property Name="aktivitas" Type="String" MaxLength="10" FixedLength="false" Unicode="false" />
    <Property Name="date_log" Type="DateTime" Precision="3" />
    <NavigationProperty Name="tblUser" Relationship="KoperasiModel.FK_tblLog_tblUser" FromRole="tblLog" ToRole="tblUser" />
  </EntityType>
  <EntityType Name="tblProduk">
    <Key>
      <PropertyRef Name="id" />
    </Key>
    <Property Name="id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="kode_barang" Type="String" MaxLength="25" FixedLength="false" Unicode="false" />
    <Property Name="nama_barang" Type="String" MaxLength="100" FixedLength="false" Unicode="false" />
    <Property Name="stok" Type="Int32" />
    <Property Name="harga_satuan" Type="Double" />
    <Property Name="kategori" Type="String" MaxLength="50" FixedLength="false" Unicode="false" />
    <NavigationProperty Name="tblDetail_transaksi" Relationship="KoperasiModel.FK_tblDetail_transaksi_tblProduk" FromRole="tblProduk" ToRole="tblDetail_transaksi" />
