  </Association>
  <Association Name="FK_tblTransaksi_tblUser">
    <End Type="KoperasiModel.tblUser" Role="tblUser" Multiplicity="1" />
    <End Type="KoperasiModel.tblTransaksi" Role="tblTransaksi" Multiplicity="*" />
