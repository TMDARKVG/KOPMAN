<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="KoperasiModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityContainer Name="KoperasiEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="sysdiagrams" EntityType="KoperasiModel.sysdiagram" />
    <EntitySet Name="tblDetail_transaksi" EntityType="KoperasiModel.tblDetail_transaksi" />
    <EntitySet Name="tblLogs" EntityType="KoperasiModel.tblLog" />
    <EntitySet Name="tblProduks" EntityType="KoperasiModel.tblProduk" />
    <EntitySet Name="tblTransaksis" EntityType="KoperasiModel.tblTransaksi" />
    <EntitySet Name="tblUsers" EntityType="KoperasiModel.tblUser" />
    <AssociationSet Name="FK_tblDetail_transaksi_tblTransaksi" Association="KoperasiModel.FK_tblDetail_transaksi_tblTransaksi">
      <End Role="tblTransaksi" EntitySet="tblTransaksis" />
      <End Role="tblDetail_transaksi" EntitySet="tblDetail_transaksi" />
    </AssociationSet>
    <AssociationSet Name="FK_tblLog_tblUser" Association="KoperasiModel.FK_tblLog_tblUser">
      <End Role="tblUser" EntitySet="tblUsers" />
      <End Role="tblLog" EntitySet="tblLogs" />
    </AssociationSet>
    <AssociationSet Name="FK_tblTransaksi_tblUser" Association="KoperasiModel.FK_tblTransaksi_tblUser">
      <End Role="tblUser" EntitySet="tblUsers" />
      <End Role="tblTransaksi" EntitySet="tblTransaksis" />
