  </EntityType>
  <EntityType Name="tblUser">
    <Key>
      <PropertyRef Name="id" />
    </Key>
    <Property Name="id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="username" Type="String" MaxLength="100" FixedLength="false" Unicode="false" />
    <Property Name="password" Type="String" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="fullname" Type="String" MaxLength="50" FixedLength="false" Unicode="false" />
    <Property Name="date_of_birth" Type="DateTime" Precision="3" />
    <Property Name="number_phone" Type="String" MaxLength="100" FixedLength="false" Unicode="false" />
    <Property Name="role" Type="Boolean" />
    <NavigationProperty Name="tblLogs" Relationship="KoperasiModel.FK_tblLog_tblUser" FromRole="tblUser" ToRole="tblLog" />
    <NavigationProperty Name="tblTransaksis" Relationship="KoperasiModel.FK_tblTransaksi_tblUser" FromRole="tblUser" ToRole="tblTransaksi" />
  </EntityType>
  <Association Name="FK_tblDetail_transaksi_tblTransaksi">
    <End Type="KoperasiModel.tblTransaksi" Role="tblTransaksi" Multiplicity="1" />
    <End Type="KoperasiModel.tblDetail_transaksi" Role="tblDetail_transaksi" Multiplicity="*" />
    <ReferentialConstraint>
