<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="KoperasiModelStoreContainer" CdmEntityContainer="KoperasiEntities">
    <EntitySetMapping Name="sysdiagrams">
      <EntityTypeMapping TypeName="KoperasiModel.sysdiagram">
        <MappingFragment StoreEntitySet="sysdiagrams">
          <ScalarProperty Name="definition" ColumnName="definition" />
          <ScalarProperty Name="version" ColumnName="version" />
          <ScalarProperty Name="diagram_id" ColumnName="diagram_id" />
          <ScalarProperty Name="principal_id" ColumnName="principal_id" />
          <ScalarProperty Name="name" ColumnName="name" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="tblDetail_transaksi">
      <EntityTypeMapping TypeName="KoperasiModel.tblDetail_transaksi">
        <MappingFragment StoreEntitySet="tblDetail_transaksi">
          <ScalarProperty Name="subtotal" ColumnName="subtotal" />
          <ScalarProperty Name="kuantitas" ColumnName="kuantitas" />
          <ScalarProperty Name="nama_barang" ColumnName="nama_barang" />
          <ScalarProperty Name="id_produck" ColumnName="id_produck" />
          <ScalarProperty Name="id_transaksi" ColumnName="id_transaksi" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="tblLogs">
      <EntityTypeMapping TypeName="KoperasiModel.tblLog">
        <MappingFragment StoreEntitySet="tblLog">
          <ScalarProperty Name="date_log" ColumnName="date_log" />
          <ScalarProperty Name="aktivitas" ColumnName="aktivitas" />
          <ScalarProperty Name="id_user" ColumnName="id_user" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="tblProduks">
      <EntityTypeMapping TypeName="KoperasiModel.tblProduk">
        <MappingFragment StoreEntitySet="tblProduk">
          <ScalarProperty Name="kategori" ColumnName="kategori" />
          <ScalarProperty Name="harga_satuan" ColumnName="harga_satuan" />
          <ScalarProperty Name="stok" ColumnName="stok" />
          <ScalarProperty Name="nama_barang" ColumnName="nama_barang" />
          <ScalarProperty Name="kode_barang" ColumnName="kode_barang" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="tblTransaksis">
      <EntityTypeMapping TypeName="KoperasiModel.tblTransaksi">
        <MappingFragment StoreEntitySet="tblTransaksi">
          <ScalarProperty Name="tanggal_transaksi" ColumnName="tanggal_transaksi" />
          <ScalarProperty Name="harga_total" ColumnName="harga_total" />
          <ScalarProperty Name="kuantitas" ColumnName="kuantitas" />
          <ScalarProperty Name="id_produk" ColumnName="id_produk" />
          <ScalarProperty Name="id_user" ColumnName="id_user" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="tblUsers">
      <EntityTypeMapping TypeName="KoperasiModel.tblUser">
        <MappingFragment StoreEntitySet="tblUser">
          <ScalarProperty Name="role" ColumnName="role" />
          <ScalarProperty Name="number_phone" ColumnName="number_phone" />
          <ScalarProperty Name="date_of_birth" ColumnName="date_of_birth" />
          <ScalarProperty Name="fullname" ColumnName="fullname" />
          <ScalarProperty Name="password" ColumnName="password" />
          <ScalarProperty Name="username" ColumnName="username" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>